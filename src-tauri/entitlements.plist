<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements (design 030 E3): files only where the user chose them in a
  dialog. No sandbox (as before) – the AI bridge listens on 127.0.0.1 only.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
