{
  "name": "app-iconic",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "tauri dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,html,css}\" \"scripts/*.mjs\" playwright.config.ts",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,html,css}\" \"scripts/*.mjs\" playwright.config.ts",
    "fixtures": "node scripts/fixtures.mjs",
    "fixtures:check": "node scripts/fixtures.mjs --check",
    "symbols:data": "node scripts/symbol-data.mjs",
    "symbols:check": "node scripts/symbol-data.mjs --check",
    "scripts:test": "node --test \"scripts/*.test.mjs\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:mac:local": "tauri build --bundles app,dmg",
    "tauri:build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "mcp:sidecar": "node scripts/mcp-sidecar.mjs",
    "mcp:sidecar:dev": "node scripts/mcp-sidecar.mjs --dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "pnpm version:check && pnpm fixtures:check && pnpm symbols:check && pnpm scripts:test && pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test && pnpm notices:check && pnpm licenses:check",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:notes": "node scripts/release-notes.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "licenses:report": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@phosphor-icons/core": "2.1.1",
    "@tabler/icons": "3.49.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-static": "1.55.0",
    "paper": "0.12.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.3",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/autocomplete": "6.20.3",
      "@lezer/common": "1.5.3"
    }
  }
}
