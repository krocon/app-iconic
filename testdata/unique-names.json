{
  "_comment": "Unique asset and layer names (design 002 E12, legacy §3; prompt 031: Windows characters and reserved names, at most 200 bytes). Shared by the Rust tests (names.rs) and the TypeScript twin (unique-names.ts). existing = names already in the document.",
  "asset": [
    { "base": "logo.svg", "existing": [], "expected": "logo.svg" },
    { "base": "logo.svg", "existing": ["logo.svg"], "expected": "logo 2.svg" },
    { "base": "logo.svg", "existing": ["logo.svg", "logo 2.svg"], "expected": "logo 3.svg" },
    { "base": "logo.svg", "existing": ["LOGO.SVG"], "expected": "logo 2.svg" },
    { "base": "logo", "existing": [], "expected": "logo" },
    { "base": "logo", "existing": ["logo"], "expected": "logo 2.svg" },
    { "base": "logo.png", "existing": ["logo.png"], "expected": "logo 2.png" },
    { "base": "logo-scanner 3.svg", "existing": ["logo-scanner 3.svg"], "expected": "logo-scanner 3 2.svg" },
    { "base": "", "existing": [], "expected": "layer.svg" },
    { "base": "   ", "existing": ["layer.svg"], "expected": "layer 2.svg" },
    { "base": "a/b:c.svg", "existing": [], "expected": "a-b-c.svg" },
    { "base": "Größe.svg", "existing": ["Größe.svg"], "expected": "Größe 2.svg" },
    { "base": "Ä 😀.svg", "existing": ["ä 😀.svg"], "expected": "Ä 😀 2.svg" },
    { "base": ".svg", "existing": [], "expected": "svg" },
    { "base": "..", "existing": [], "expected": "layer.svg" },
    { "base": "a<b>c\"d|e?f*g.svg", "existing": [], "expected": "a-b-c-d-e-f-g.svg" },
    { "base": "con.svg", "existing": [], "expected": "_con.svg" },
    { "base": "NUL", "existing": [], "expected": "_NUL" },
    { "base": "com1.tar.svg", "existing": [], "expected": "_com1.tar.svg" },
    { "base": "com10.svg", "existing": [], "expected": "com10.svg" },
    { "base": "console.svg", "existing": [], "expected": "console.svg" },
    { "base": "logo. . ", "existing": [], "expected": "logo" },
    { "base": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.svg", "existing": [], "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.svg" },
    { "base": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.svg", "existing": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.svg"], "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 2.svg" },
    { "base": "üüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüü.svg", "existing": [], "expected": "üüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüü.svg" }
  ],
  "layer": [
    { "base": "logo", "existing": [], "expected": "logo" },
    { "base": "logo", "existing": ["logo"], "expected": "logo 2" },
    { "base": "logo", "existing": ["logo", "Logo 2"], "expected": "logo 3" },
    { "base": "  logo  ", "existing": [], "expected": "logo" },
    { "base": "", "existing": [], "expected": "layer" },
    { "base": " \n ", "existing": ["layer"], "expected": "layer 2" },
    { "base": "Über", "existing": ["Über"], "expected": "Über 2" }
  ]
}
